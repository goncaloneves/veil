{
  "name": "veil",
  "version": "0.1.0",
  "description": "Masks your secrets before your coding agent's model sees them.",
  "license": "MIT",
  "author": "Gonçalo Neves (https://github.com/goncaloneves)",
  "homepage": "https://github.com/goncaloneves/veil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goncaloneves/veil.git"
  },
  "bugs": "https://github.com/goncaloneves/veil/issues",
  "keywords": [
    "secrets",
    "masking",
    "redaction",
    "claude-code",
    "coding-agent",
    "gitleaks",
    "security"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "veil": "src/cli/main.ts"
  },
  "scripts": {
    "veil": "node src/cli/main.ts",
    "test": "node --test \"test/**/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json",
    "check": "npm run typecheck && npm test && claude plugin validate .",
    "sync:gitleaks": "node scripts/sync-gitleaks.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
